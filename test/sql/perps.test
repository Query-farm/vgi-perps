# ------------------------------------------------- pagination (synthetic)
# tests/fixtures/venues/synthetic: three cursor pages, the last one empty but
# still carrying a cursor. Every page must arrive exactly once, on every
# transport (over HTTP each page is a separate continuation), and the scan must
# stop at the empty page. 7.0000/contract / 0.0001 BTC = 70000 USD/BTC; 10
# contracts = 0.001 BTC = 70 USD.
query ITTTTT
SELECT count(*), min(trade_id), max(trade_id), round(sum(size_contracts), 2), round(sum(size_usd), 4), count(*) FILTER (WHERE is_block_trade) FROM perps.main.trades('kalshi', 'KXBTCPERP', start_date := TIMESTAMPTZ '2026-11-01 00:00:00+00', end_date := TIMESTAMPTZ '2026-11-01 00:10:00+00');
----
5	synthetic-1	synthetic-5	118.0	826.308	1

query TTTTT
SELECT trade_id, price, size_contracts, round(size_usd, 4), taker_side FROM perps.main.trades('kalshi', 'KXBTCPERP', start_date := TIMESTAMPTZ '2026-11-01 00:00:00+00', end_date := TIMESTAMPTZ '2026-11-01 00:10:00+00') ORDER BY ts;
----
synthetic-5	70030.0	100.0	700.3	buy
synthetic-4	70020.0	2.0	14.004	sell
synthetic-3	69990.0	1.0	6.999	buy
synthetic-2	70010.0	5.0	35.005	sell
synthetic-1	70000.0	10.0	70.0	buy

# max_trades stops mid-scan, across a page boundary.
query I
SELECT count(*) FROM perps.main.trades('kalshi', 'KXBTCPERP', start_date := TIMESTAMPTZ '2026-11-01 00:00:00+00', end_date := TIMESTAMPTZ '2026-11-01 00:10:00+00', max_trades := 4);
----
4

# ----------------------------------------------------- exact golden checks
# The sqllogictest runner compares numbers with ~1% tolerance (a 0.4% error
# passes), which is too loose for unit and sign conventions. These assert
# hand-computed values to a relative 1e-9 and return a single 'true'.

statement ok
CREATE MACRO near(a, b) AS abs(a - b) <= 1e-9 * greatest(abs(b), 1e-300);

# Contract sizes and ticks per underlying unit, from each venue's native quoting.
query T
SELECT bool_and(CASE symbol
    WHEN 'KXBTCPERP' THEN near(contract_size, 0.0001) AND near(tick_size, 1.0)          -- 0.0001 BTC; 0.0001 $/contract / 0.0001
    WHEN 'KXKSHIBPERP' THEN near(contract_size, 1e6) AND near(tick_size, 1e-10)         -- 1000 kSHIB x 1000; 0.0001 / 1e6
    WHEN 'SHP-20DEC30-CDE' THEN near(contract_size, 1e7) AND near(tick_size, 1e-8)      -- 10000 x 1000SHIB; 0.00001 / 1000
    WHEN 'PBTCURZ50' THEN near(contract_size, 0.0001) AND near(tick_size, 5.0)          -- myrio BTC; tick = price_increment
    WHEN 'kSHIB' THEN near(contract_size, 1000.0)                                       -- Hyperliquid kSHIB = 1000 SHIB
    ELSE true END) AND count(*) = 9
FROM perps.main.instruments() WHERE underlying IN ('BTC', 'SHIB');
----
true

# Kalshi 2026-11-12T21:00Z: rate 0.0001450796460962 (native sign), 8h -> x1095,
# mark "7.1395" per contract / 0.0001 BTC = 71395 USD/BTC.
query T
SELECT near(rate_per_interval, 0.0001450796460962) AND near(rate_annualized, 0.0001450796460962 * 1095) AND near(mark_price, 71395.0) AND near(rate_bps, 1.450796460962)
FROM perps.main.funding(venue := 'kalshi', underlying := 'BTC', start_date := TIMESTAMPTZ '2026-11-10 00:00:00+00', end_date := TIMESTAMPTZ '2026-11-12 23:59:59+00') WHERE funding_time = TIMESTAMPTZ '2026-11-12 21:00:00+00';
----
true

# Bitnomial 2026-11-12T17:00Z: mark 14450 ticks x 5 = 72250, index 14326 x 5 = 71630.
query T
SELECT near(mark_price, 72250.0) AND near(index_price, 71630.0) AND near(premium_bps, (72250.0 / 71630.0 - 1) * 10000) AND near(rate_annualized, 0.0001 * 1095)
FROM perps.main.funding(venue := 'bitnomial', underlying := 'BTC', start_date := TIMESTAMPTZ '2026-11-12 00:00:00+00', end_date := TIMESTAMPTZ '2026-11-12 23:59:59+00') WHERE symbol = 'PBTCUCZ50' AND funding_time = TIMESTAMPTZ '2026-11-12 17:00:00+00';
----
true

# Annualization invariant across every venue and interval (1h, 8h).
query T
SELECT bool_and(near(rate_annualized, rate_per_interval * 8760 / interval_hours)) AND count(DISTINCT interval_hours) = 2
FROM perps.main.funding(underlying := 'BTC', start_date := TIMESTAMPTZ '2026-11-10 00:00:00+00', end_date := TIMESTAMPTZ '2026-11-12 23:59:59+00', include_estimates := true) WHERE rate_per_interval <> 0;
----
true

# Marks: Kalshi settlement mark "7.0793" / 0.0001; Coinbase mid "70817.5" per BTC;
# premium_bps = (mark / index - 1) * 1e4 everywhere.
query T
SELECT bool_and(CASE symbol WHEN 'KXBTCPERP' THEN near(mark_price, 70793.0) WHEN 'BIP-20DEC30-CDE' THEN near(mark_price, 70817.5) ELSE true END)
   AND bool_and(premium_bps IS NULL OR near(premium_bps, (mark_price / index_price - 1) * 10000))
   AND bool_and(open_interest_usd IS NULL OR open_interest_usd > 0)
FROM perps.main.marks(underlying := 'BTC');
----
true

# Book: Kalshi best ask "7.0884" / 0.0001 = 70884; size_usd = contracts x contract_size x price.
query T
SELECT bool_and(near(size_usd, size_contracts * 0.0001 * price)) AND bool_or(side = 'ask' AND level = 1 AND near(price, 70884.0) AND near(size_base, 0.015))
FROM perps.main.order_book('kalshi', 'KXBTCPERP', depth := 5);
----
true

# Synthetic trades: sum of contracts x 0.0001 x price = 826.308.
query T
SELECT near(sum(size_usd), 826.308) FROM perps.main.trades('kalshi', 'KXBTCPERP', start_date := TIMESTAMPTZ '2026-11-01 00:00:00+00', end_date := TIMESTAMPTZ '2026-11-01 00:10:00+00');
----
true

# Hyperliquid BTC, mark 70938, mm = 0.5 / 40 = 0.0125:
# long 20x  = 70938 * (1 - 1/20) / (1 - 0.0125); short 20x = 70938 * (1 + 1/20) / (1 + 0.0125).
query T
SELECT bool_and(CASE side WHEN 'long' THEN near(liquidation_price, 70938 * 0.95 / 0.9875) ELSE near(liquidation_price, 70938 * 1.05 / 1.0125) END)
FROM perps.main.liquidation_estimate('hyperliquid', 'BTC') WHERE leverage = 20;
----
true

