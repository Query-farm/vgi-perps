# ----------------------------------------------------------------- funding

# Kalshi BTC: 8h funding, native sign kept, mark rescaled from per-contract (x 1/0.0001).
query TTTTTT
SELECT strftime(funding_time, '%Y-%m-%dT%H:%M:%SZ'), round(rate_per_interval, 10), interval_hours, round(rate_annualized, 8), mark_price, is_final FROM perps.main.funding(venue := 'kalshi', underlying := 'BTC', start_date := TIMESTAMPTZ '2026-11-10 00:00:00+00', end_date := TIMESTAMPTZ '2026-11-12 23:59:59+00') ORDER BY funding_time;
----
2026-11-10T05:00:00Z	0.0001520963	8.0	0.16654541	74711.0	true
2026-11-10T13:00:00Z	0.0001669038	8.0	0.18275965	74308.0	true
2026-11-10T21:00:00Z	0.0001325884	8.0	0.14518432	73703.0	true
2026-11-11T05:00:00Z	0.0002422985	8.0	0.26531685	73639.0	true
2026-11-11T13:00:00Z	0.0	8.0	0.0	73822.0	true
2026-11-11T21:00:00Z	0.0	8.0	0.0	74587.0	true
2026-11-12T05:00:00Z	0.0001997953	8.0	0.21877585	73647.0	true
2026-11-12T13:00:00Z	0.000170408	8.0	0.18659679	72805.0	true
2026-11-12T21:00:00Z	0.0001450796	8.0	0.15886221	71395.0	true

# Every US venue at once (offshore venues need an underlying, so they are not scanned).
query TITT
SELECT venue, count(*), round(min(rate_per_interval), 10), round(max(rate_per_interval), 10) FROM perps.main.funding(start_date := TIMESTAMPTZ '2026-11-10 00:00:00+00', end_date := TIMESTAMPTZ '2026-11-12 23:59:59+00') GROUP BY venue ORDER BY venue;
----
bitnomial	54	0.0001	0.0001
kalshi	66	-0.0006446722	0.0006275553

# Cross-venue BTC with estimates: Binance and Bybit fail and are skipped with a warning.
query TTIIT
SELECT venue, symbol, count(*) FILTER (WHERE is_final), count(*) FILTER (WHERE NOT is_final), round(avg(rate_annualized) FILTER (WHERE is_final), 8) FROM perps.main.funding(underlying := 'BTC', start_date := TIMESTAMPTZ '2026-11-10 00:00:00+00', end_date := TIMESTAMPTZ '2026-11-12 23:59:59+00', include_estimates := true) GROUP BY ALL ORDER BY ALL;
----
bitnomial	PBTCUCZ50	9	1	0.1095
bitnomial	PBTCURZ50	9	1	0.1095
hyperliquid	BTC	72	1	0.08642934
kalshi	KXBTCPERP	9	1	0.14711568

# Bitnomial publishes mark and index (in ticks) with every settlement.
query TTTTT
SELECT strftime(funding_time, '%Y-%m-%dT%H:%M:%SZ'), rate_per_interval, mark_price, index_price, round(premium_bps, 6) FROM perps.main.funding(venue := 'bitnomial', underlying := 'BTC', start_date := TIMESTAMPTZ '2026-11-12 00:00:00+00', end_date := TIMESTAMPTZ '2026-11-12 23:59:59+00') WHERE symbol = 'PBTCUCZ50' ORDER BY funding_time;
----
2026-11-12T01:00:00Z	0.0001	74625.0	73930.0	94.007845
2026-11-12T09:00:00Z	0.0001	74220.0	73570.0	88.35123
2026-11-12T17:00:00Z	0.0001	72250.0	71630.0	86.555912

# Empty window: no settlement between two funding times.
query I
SELECT count(*) FROM perps.main.funding(venue := 'kalshi', underlying := 'BTC', start_date := TIMESTAMPTZ '2026-11-12 06:00:00+00', end_date := TIMESTAMPTZ '2026-11-12 07:00:00+00');
----
0

