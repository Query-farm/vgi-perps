# ------------------------------------------------------------- error paths
# Error text below is this worker's own; SDK-worded bind errors use <REGEX>.

# A single-venue query surfaces the venue failure instead of skipping it.
statement error
SELECT * FROM perps.main.funding(venue := 'binance', underlying := 'BTC');
----
<REGEX>:.*binance.*451.*

# Offshore venues list hundreds of contracts: per-contract calls need an underlying.
statement error
SELECT * FROM perps.main.funding(venue := 'hyperliquid');
----
<REGEX>:.*pass underlying.*

statement error
SELECT * FROM perps.main.order_book('bitnomial', 'PBTCUCZ50');
----
<REGEX>:.*bitnomial does not support order_book.*WebSocket.*

statement error
SELECT * FROM perps.main.trades('hyperliquid', 'BTC');
----
<REGEX>:.*hyperliquid does not support trades.*

statement error
SELECT * FROM perps.main.candles('bitnomial', 'PBTCUCZ50', bar := '1h');
----
<REGEX>:.*bitnomial does not support candles.*

# No published maintenance schedule: refuse rather than guess.
statement error
SELECT * FROM perps.main.liquidation_estimate('kalshi', 'KXBTCPERP');
----
<REGEX>:.*liquidation_estimate refuses kalshi.*mm_rate.*

statement error
SELECT * FROM perps.main.liquidation_estimate('hyperliquid', 'BTC', leverages := '2,0.5', weights := '1,1');
----
<REGEX>:.*leverage must be > 1.*

statement error
SELECT * FROM perps.main.liquidation_estimate('hyperliquid', 'BTC', leverages := '2,3');
----
<REGEX>:.*2 leverages and 5 weights.*

statement error
SELECT * FROM perps.main.order_book('kalshi', 'NOT-A-TICKER');
----
