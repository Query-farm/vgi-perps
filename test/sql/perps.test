# name: test/sql/perps.test
# description: SQL-level tests for the perps worker, replaying recorded venue responses
# group: [perps]
#
# ci/run-integration.sh exports PERPS_FIXTURES_DIR (tests/fixtures/venues) and
# PERPS_NOW, so every request is answered from a recording and default windows
# resolve deterministically. Expected values were checked by hand against the
# raw recorded payloads (see tests/test_golden_fixtures.py for the arithmetic).

require vgi

require-env PERPS_WORKER

require-env PERPS_FIXTURES_DIR

statement ok
ATTACH 'perps' (TYPE vgi, LOCATION '{PERPS_WORKER}');

# ------------------------------------------------------------------ venues

# Binance and Bybit geo-block the recording host (HTTP 451 / 403); the probe
# reports the failure as a row instead of failing the query.
query TTI
SELECT venue, status, instrument_count FROM perps.main.venues() ORDER BY venue;
----
binance	error	NULL
bitnomial	ok	6
bybit	error	NULL
coinbase	ok	8
hyperliquid	ok	6
kalshi	ok	14

query TTT
SELECT venue, venue_type, sign_convention FROM perps.main.venues(probe := false) ORDER BY venue;
----
binance	offshore	ccxt unified: positive = longs pay shorts (no flip)
bitnomial	us_regulated	native: positive = longs pay shorts (no flip)
bybit	offshore	ccxt unified: positive = longs pay shorts (no flip)
coinbase	us_regulated	native: positive = longs pay shorts (CFTC filing 2025-32 App. B; no flip)
hyperliquid	offshore	ccxt unified: positive = longs pay shorts (no flip)
kalshi	us_regulated	native: positive = longs pay shorts (no flip)

query TT
SELECT venue, left(last_error, 40) FROM perps.main.venues() WHERE status = 'error' ORDER BY venue;
----
binance	VenueError: binance (ccxt binanceusdm) f
bybit	VenueError: bybit (ccxt bybit) fetch_mar

# ------------------------------------------------------------ capabilities

query TTTT
SELECT venue, capability, support, auth_required FROM perps.main.capabilities() WHERE support <> 'supported' ORDER BY venue, capability;
----
binance	maintenance_margin	unsupported	true
binance	open_interest	partial	false
binance	premium_index	unsupported	false
binance	trades	partial	false
bitnomial	candles	partial	false
bitnomial	maintenance_margin	unsupported	false
bitnomial	marks	partial	false
bitnomial	order_book	unsupported	false
bitnomial	premium_index	unsupported	false
bitnomial	trades	unsupported	false
bybit	maintenance_margin	unsupported	false
bybit	open_interest	partial	false
bybit	premium_index	unsupported	false
bybit	trades	partial	false
coinbase	funding_estimate	unsupported	false
coinbase	funding_history	partial	true
coinbase	maintenance_margin	unsupported	false
coinbase	marks	partial	false
coinbase	premium_index	unsupported	false
hyperliquid	open_interest	partial	false
hyperliquid	premium_index	unsupported	false
hyperliquid	trades	unsupported	false
kalshi	maintenance_margin	unsupported	true

# ------------------------------------------------------------- instruments

# Contract size in BTC per contract, tick in USD per BTC, regardless of quoting:
# Kalshi quotes per contract, Bitnomial in ticks, Coinbase per BTC.
query TTTTTTTT
SELECT venue, symbol, contract_size, tick_size, funding_interval_hours, funding_cap, round(max_leverage, 4), maintenance_margin_rate FROM perps.main.instruments(underlying := 'BTC') ORDER BY venue, symbol;
----
bitnomial	PBTCUCZ50	0.01	5.0	8.0	0.0005	NULL	NULL
bitnomial	PBTCURZ50	0.0001	5.0	8.0	0.0005	NULL	NULL
coinbase	BIP-20DEC30-CDE	0.01	5.0	1.0	NULL	9.9921	NULL
hyperliquid	BTC	1.0	1.0	1.0	0.005	40.0	0.0125
kalshi	KXBTCPERP	0.0001	1.0	8.0	0.02	6.3858	NULL

# 1000x units: Kalshi kSHIB (1000 kSHIB x 1000 SHIB), Coinbase 1000SHIB (10000 x 1000), Hyperliquid kSHIB.
query TTTT
SELECT venue, symbol, contract_size, tick_size FROM perps.main.instruments(underlying := 'SHIB') ORDER BY venue, symbol;
----
bitnomial	PSHBUKZ50	1000.0	2e-06
coinbase	SHP-20DEC30-CDE	10000000.0	1e-08
hyperliquid	kSHIB	1000.0	1e-09
kalshi	KXKSHIBPERP	1000000.0	1e-10

query TTI
SELECT asset_class, instrument_type, count(*) FROM perps.main.instruments(venue := 'kalshi', include_inactive := true) GROUP BY ALL ORDER BY ALL;
----
commodity	perp_style_future	2
commodity	perpetual	2
crypto	perpetual	5
equity	perpetual	3
index	perpetual	2

# Dated Coinbase futures (BIT-27NOV26-CDE) are not perps and are filtered out.
query T
SELECT symbol FROM perps.main.instruments(venue := 'coinbase') ORDER BY symbol;
----
